#include "global.glsl"

layout(location = 0) out vec4 color;

layout(binding = 0) uniform sampler2D samp0;
layout(binding = 1) uniform sampler2D samp1;

in VS_OUT
{
    vec4 texcoord[2];
    vec4 color;
} fragment;

void main()
{
    color = texture(samp0, fragment.texcoord[0].xy) * texture(samp1, fragment.texcoord[1].xy) * uProgramEnv[PP_COLOR_GLSL];
}
